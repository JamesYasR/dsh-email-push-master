{
  "name": "dsh-email-push-master",
  "version": "1.2.0",
  "description": "Email reminders from your DSH agent when you're away — a hardened fork of dsh-notify-skill: stable SMTP (no 535 retry loop), connect/idle timeouts, --check self-test, and full message headers.",
  "type": "module",
  "license": "MIT",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "sender.mjs",
    "client",
    "cordis.patch.yml",
    "skills",
    "config.example.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skill",
    "notify",
    "email",
    "smtp"
  ],
  "author": "JamesYasR",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JamesYasR/dsh-email-push-master.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "scripts": {
    "verify": "node --check index.mjs && node --check sender.mjs && node --check client/client.js"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/JamesYasR/dsh-email-push-master#readme",
  "bugs": {
    "url": "https://github.com/JamesYasR/dsh-email-push-master/issues"
  }
}

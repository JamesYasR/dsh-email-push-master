{
  "name": "dsh-email-push-master",
  "version": "1.3.0",
  "description": "Email reminders from your DSH agent when you're away — a hardened fork of dsh-notify-skill: stable SMTP (no 535 retry loop), connect/idle timeouts, --check self-test, full message headers, and a Web GUI settings page for DSH 0.2.0-rc.2+.",
  "type": "module",
  "license": "MIT",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "sender.mjs",
    "client",
    "cordis.patch.yml",
    "skills",
    "docs",
    "config.example.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-client-plugin",
    "skill",
    "notify",
    "email",
    "smtp"
  ],
  "author": "JamesYasR",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0-0",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JamesYasR/dsh-email-push-master.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "verify": "node --check index.mjs && node --check sender.mjs && node --check client/client.js"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "homepage": "https://github.com/JamesYasR/dsh-email-push-master#readme",
  "bugs": {
    "url": "https://github.com/JamesYasR/dsh-email-push-master/issues"
  }
}
